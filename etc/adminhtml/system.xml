<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="doitshipping"
                   translate="label"
                   type="text"
                   sortOrder="90"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Doit Delivery</label>
                <field id="active"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="title"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Carrier Title</label>
                    <validate>required-entry</validate>
                </field>

                <field id="name"
                       translate="label"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Method Title</label>
                    <validate>required-entry</validate>
                </field>

                <field id="price"
                       translate="label comment"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Price Per Order</label>
                    <comment>Amount in the website base currency.</comment>
                    <validate>required-entry validate-number validate-zero-or-greater</validate>
                </field>
                <field id="express_surcharge"
                       translate="label comment"
                       type="text"
                       sortOrder="80"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Express Surcharge</label>
                    <comment>Extra charge per order in the website base currency.</comment>
                    <validate>required-entry validate-number validate-zero-or-greater</validate>
                </field>
                <field id="sort_order"
                       translate="label"
                       type="text"
                       sortOrder="50"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="sallowspecific"
                       translate="label"
                       type="select"
                       sortOrder="60"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Ship to Applicable Countries</label>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>

                <field id="specificcountry"
                       translate="label"
                       type="multiselect"
                       sortOrder="70"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                    <depends>
                        <field id="sallowspecific">1</field>
                    </depends>
                </field>
            </group>

        </section>
    </system>
</config>
